<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:padding="8dp"
    android:orientation="vertical"
    android:background="@drawable/product_card_bg"
    android:elevation="2dp">
    <ImageView
        android:id="@+id/productImage"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:scaleType="fitCenter"
        android:contentDescription="Product image" android:padding="5dp"/>
    <TextView
        android:id="@+id/productName"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:text="Wireless Camera 1080P HD Webcam" android:textColor="#999999"
        android:textSize="11sp"
        android:maxLines="2"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/productPrice"
            android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="US$48.89"
            android:textColor="#222222"
            android:textStyle="bold"
            android:textSize="15sp"
            />
        <ImageButton
            android:id="@+id/addToCart"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_cart"
            android:background="@android:color/transparent"
            android:contentDescription="Add to cart" android:padding="4dp"/>
    </LinearLayout>
</LinearLayout>

